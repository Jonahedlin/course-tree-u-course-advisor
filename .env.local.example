# Auth0 frontend config — copy this file to `.env.local` and fill in the
# values from your Auth0 tenant, then restart `npm run dev`.
#
# From the Auth0 dashboard:
#   - Create a "Single Page Application" -> use its Domain and Client ID below
#   - Create an "API" (Applications -> APIs) -> use its Identifier as the audience
#   - In the SPA settings, add http://localhost:5173 to:
#       Allowed Callback URLs, Allowed Logout URLs, Allowed Web Origins

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
